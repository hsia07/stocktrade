+def make_l1_complete() -> L1WalkForwardEvidence:
+    return L1WalkForwardEvidence(
+        train_window_count=10,
+        test_window_count=5,
+        out_of_sample_windows=3,
+        walk_forward_splits=[{"train": 1, "test": 1}],
+        no_lookahead_leak=True,
