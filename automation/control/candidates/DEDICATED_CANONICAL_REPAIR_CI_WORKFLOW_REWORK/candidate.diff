+result = subprocess.run(['git', 'diff', '--name-only', '${BASE}..HEAD', '--', 'automation/control/candidates/'], capture_output=True, text=True)
+dirs = set()
+for line in result.stdout.strip().splitlines():
+    line = line.strip()
+    if not line:
+        continue
+    from pathlib import Path
+    p = Path(line)
+    parent = p.parent
+    while parent.name:
+        if (parent / 'evidence.json').exists():
+            dirs.add(parent.as_posix())
+            break
+        parent = parent.parent
+if dirs:
+    print(' '.join(sorted(dirs)))
+else:
+    print('NONE')
+          ")
+          echo "candidate_dirs=$DIRS" >> $GITHUB_OUTPUT
+
+      - name: Validate canonical repair evidence
+        run: |
+          DIRS="${{ steps.detect.outputs.candidate_dirs }}"
+          if [ "$DIRS" = "NONE" ]; then
+            echo "FAIL: no changed candidate evidence package found in diff"
+            echo "Checked: automation/control/candidates/"
+            exit 1
+          fi
+          for d in $DIRS; do
