+          python -m pip install --upgrade pip
+          pip install pyyaml jsonschema
+
+      - name: Detect changed candidate evidence packages
+        id: detect
+        run: |
+          if git rev-parse HEAD~1 >/dev/null 2>&1; then
+            BASE="HEAD~1"
+          else
+            BASE="$(git rev-list --max-parents=0 HEAD)"
+          fi
+          DIRS=$(python -c "
