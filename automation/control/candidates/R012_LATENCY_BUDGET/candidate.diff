+        )
+        # Should not crash; should use local fallback
+        assert decision.local_fallback_used is True
+        assert decision.order_execution_allowed is False
+
+
+# ═══════════════════════════════════════════════════════════════
+# 4. LLM Format / Provider Error → Local Fallback
+# ═══════════════════════════════════════════════════════════════
